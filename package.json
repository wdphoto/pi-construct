{
  "name": "pi-construct",
  "version": "0.0.34",
  "description": "A minimal Pi loadout menu for project-local packages.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "construct"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wdphoto/pi-construct.git"
  },
  "bugs": {
    "url": "https://github.com/wdphoto/pi-construct/issues"
  },
  "homepage": "https://github.com/wdphoto/pi-construct#readme",
  "files": [
    "extensions/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/construct/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "check:hygiene": "tsc --noEmit --noUnusedLocals --noUnusedParameters --pretty false",
    "pack:dry-run": "npm pack --dry-run",
    "release:verify": "npm run check && npm run pack:dry-run",
    "smoke:all": "npm run smoke && npm run package-resource-plans-smoke && npm run effective-state-smoke && npm run dashboard-submit-safety-smoke && npm run dashboard-unload-smoke && npm run scan-trust-smoke && npm run project-overrides-smoke && npm run dashboard-action-model-smoke && npm run direct-resource-toggle-smoke && npm run skill-repositories-smoke && npm run load-concept-smoke && npm run e2e-smoke && npm run install-smoke && npm run invalid-drift-smoke && npm run audit-regression-smoke",
    "prepublishOnly": "npm run release:verify",
    "smoke": "./scripts/smoke.sh",
    "package-resource-plans-smoke": "./scripts/package-resource-plans-smoke.sh",
    "effective-state-smoke": "./scripts/effective-state-smoke.sh",
    "dashboard-submit-safety-smoke": "./scripts/dashboard-submit-safety-smoke.sh",
    "dashboard-unload-smoke": "./scripts/dashboard-unload-smoke.sh",
    "scan-trust-smoke": "./scripts/scan-trust-smoke.sh",
    "project-overrides-smoke": "./scripts/project-overrides-smoke.sh",
    "install-smoke": "./scripts/install-smoke.sh",
    "e2e-smoke": "./scripts/e2e-smoke.sh",
    "invalid-drift-smoke": "./scripts/invalid-drift-smoke.sh",
    "audit-regression-smoke": "./scripts/audit-regression-smoke.sh",
    "dashboard-action-model-smoke": "./scripts/dashboard-action-model-smoke.sh",
    "direct-resource-toggle-smoke": "./scripts/direct-resource-toggle-smoke.sh",
    "skill-repositories-smoke": "./scripts/skill-repositories-smoke.sh",
    "load-concept-smoke": "./scripts/load-concept-smoke.sh"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.4",
    "@earendil-works/pi-tui": ">=0.80.4"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.4",
    "@earendil-works/pi-tui": "^0.80.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
